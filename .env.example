# Copy to .env (gitignored). Nothing here is required for dev.
# Where finc keeps its database, vault and browser profiles. Default: ./data
FINC_DATA_DIR=./data
# Local control port for the worker (health / unlock). Bound to 127.0.0.1 only.
FINC_PORT=7733
# Timezone used for the scheduler
TZ=Asia/Jerusalem
# Secrets (RiseUp token, bank logins, model API keys) live in the encrypted vault only.
# finc never reads them from the environment and deletes any API_KEY/TOKEN/PASSWORD-like variable at startup.
# The public name of the hub (docker compose needs both; the name is yours at duckdns.org):
FINC_PUBLIC_HOST=your-name.duckdns.org
FINC_DUCKDNS_DOMAIN=your-name
# The hub keys the Android app pins (P1-10; README "Phone pinning"): live key, backup key. Public values, not secrets.
FINC_TLS_PINS=
# Stock insights: the contact e-mail SEC EDGAR requires in its User-Agent (empty = company numbers off).
FINC_SEC_CONTACT=
# Logging: trace|debug|info|warn|error
LOG_LEVEL=info
# Nightly encrypted backups: a folder on ANOTHER physical disk than data/ (default ./backups).
FINC_BACKUP_HOST_DIR=
