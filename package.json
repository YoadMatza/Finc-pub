{
  "name": "finc",
  "private": true,
  "version": "0.8.13",
  "description": "finc: personal self-hosted finance hub (replaces RiseUp)",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22.22.2" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "finc": "pnpm --filter @finc/worker exec tsx src/cli.ts",
    "worker": "pnpm --filter @finc/worker dev"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
